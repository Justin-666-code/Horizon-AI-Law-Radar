{
  "ai": {
    "provider": "ali",
    "model": "qwen-plus",
    "api_key_env": "DASHSCOPE_API_KEY",
    "temperature": 0.2,
    "max_tokens": 8192,
    "throttle_sec": 0.5,
    "analysis_concurrency": 2,
    "enrichment_concurrency": 1,
    "languages": [
      "zh"
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-foundations",
    "profile_settings": {
      "ai-foundations": {
        "threshold": 6.8,
        "topic_dedup": true
      },
      "career-opportunity": {
        "threshold": 7.5,
        "topic_dedup": true
      },
      "law-governance": {
        "threshold": 7.5,
        "topic_dedup": true
      },
      "ai-research": {
        "threshold": 8.0,
        "topic_dedup": true
      },
      "tech-news": {
        "threshold": 7.5,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 6.5,
        "topic_dedup": false
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
